#!/bin/bash
#SBATCH --job-name="saxpy GPU"
#SBATCH --output=saxpy_gpu.out
#SBATCH --partition=gpu
#SBATCH --ntasks=1
#SBATCH --mem=4G
#SBATCH --gpus=1
#SBATCH --time=10:00
#SBATCH --account=ulghpsc

module load EasyBuild/2023a
module load Clang/18.1.8-GCCcore-12.3.0-CUDA-12.2.0

export OMP_TARGET_OFFLOAD=MANDATORY

# With sbatch, submit from the repository root or export PROJECT_DIR.
PROJECT_DIR="${PROJECT_DIR:-${SLURM_SUBMIT_DIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)}}"
source "${PROJECT_DIR}/Part1/scripts/environment.sh" || exit 1

mkdir -p "${EXEC_DIR}" || exit 1
clang -O3 -fopenmp -fopenmp-targets=nvptx64-nvidia-cuda \
  -o "${EXEC_DIR}/shallow_gpu" "${PROJECT_DIR}/Part1/src/shallow_gpu.c" -lm || exit 1

prepare_run "${RESULTS_DIR}/gpu_${SLURM_JOB_ID:-local}" || exit 1
"${EXEC_DIR}/shallow_gpu" "${CONFIG_DIR}/param_simple.txt"
